#!/usr/bin/env python3
# Fake tmux for sidecar tests. The pane is a text file ($FAKE_TMUX_PANE); typed text lands on the
# last input line. Enter submits (clears the input line) only when $FAKE_TMUX_SUBMIT=1: by default
# it does nothing, simulating input that was typed but never submitted.
import json, os, sys
args = sys.argv[1:]
log = os.environ.get('FAKE_TMUX_LOG')
if log:
    with open(log, 'a') as f:
        f.write(json.dumps(args) + '\n')
pane = os.environ['FAKE_TMUX_PANE']
lines = open(pane).read().splitlines()
if args[:1] == ['capture-pane']:
    print('\n'.join(lines))
elif args[:1] == ['send-keys']:
    if '-l' in args:
        lines[-1] = lines[-1] + args[-1]
    elif args[-1] == 'Enter' and os.environ.get('FAKE_TMUX_SUBMIT') == '1':
        lines[-1] = '> '
        if os.environ.get('FAKE_TMUX_TRANSCRIPT'):  # the agent takes a turn: its transcript grows
            with open(os.environ['FAKE_TMUX_TRANSCRIPT'], 'a') as t:
                t.write('turn\n')
    open(pane, 'w').write('\n'.join(lines) + '\n')
else:
    sys.exit(f'fake tmux: unsupported {args}')
